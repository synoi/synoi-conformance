{
  "kind": "completeness_assertion_v1",
  "description": "Signed synoi.completeness.v1 assertion (build1-completeness-witnessing, P4). Governed-path scope only: certifies in-scope governed-path completeness, never universal completeness. The signed body is the frozen field set canonicalized via RFC 8785 JCS (@synoi/sraid canonicalize); assertion_id = sha256(canonical body); assertion_id and attestation are EXCLUDED from the signed bytes. The hybrid Ed25519 + ML-DSA-65 DSSE envelope binds payloadType (ADR_023 D3; SRAID F7/A4). A reimplementation reproduces canonical_payload and assertion_id from body alone, and verifies the envelope with @synoi/sraid verifyAttestation.",
  "constants": {
    "schema": "synoi.completeness.v1",
    "payload_type": "application/vnd.synoi.completeness+json",
    "assertion_id_rule": "assertion_id = SHA-256(canonicalize(body)); bare lowercase hex; EXCLUDED from signed bytes",
    "canonicalization": "RFC 8785 JCS over the frozen body field set; object keys re-sorted lexicographically",
    "hybrid_rule": "attestation carries BOTH ed25519 AND ml-dsa-65 over PAE(payloadType, canonical); both required"
  },
