    "assertions": [
      {
        "field": "e1.body.replayed_after",
        "op": "eq",
        "value": "sha256:d100000000000000000000000000000000000000000000000000000000000001",
        "note": "E1.body.replayed_after must equal D1.oid"
      },
      {
        "field": "e1.prev",
        "op": "eq",
        "value": "sha256:d100000000000000000000000000000000000000000000000000000000000001",
        "note": "E1.prev (Merkle parent) must equal D1.oid"
      },
      {
        "field": "e1.body.authority.subject_oid",
        "op": "eq",
        "value": "sha256:d100000000000000000000000000000000000000000000000000000000000001",
        "note": "authority.subject_oid carries D1.oid so verifier can walk chain"
      },
      {
        "field": "d1.body.status",
        "op": "eq",
        "value": "denied",
        "note": "D1 must be a denial receipt"
      },
      {
        "field": "e1.body.status",
        "op": "eq",
        "value": "ok",
        "note": "E1 must be an execution receipt"
      },
      {
        "field": "e1.body.replayed_after",
        "op": "eq",
        "value": "e1.prev",
        "note": "replayed_after and prev must reference the same D1.oid (pattern invariant)"
      }
