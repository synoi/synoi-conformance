  {
    "name": "replay-chain: REJECT cross-principal replay (D1 principal != E1 principal)",
    "kind": "replay_chain_gate",
    "expect": "invalid",
    "expected_error_kind": "cross_principal_mismatch",
    "expected_error_detail": "E1 principal must equal D1 principal",
    "notes": [
      "D1 was denied for actor:steve-demo.",
      "An attempt to replay as actor:other-principal must be rejected.",
      "The gate compares D1.body.initiator.actor_oid against input.caller.actor_oid.",
      "Mismatch results in cross_principal_mismatch (not a grant failure)."
    ],
    "denial_principal": "actor:steve-demo",
    "replay_principal": "actor:other-principal",
    "d1_oid": "sha256:d100000000000000000000000000000000000000000000000000000000000001"
  },
  {
    "name": "replay-chain: REJECT replay of expired provisional window (D1 > 72hr old)",
    "kind": "replay_chain_gate",
    "expect": "invalid",
    "expected_error_kind": "provisional_window_expired",
    "expected_error_detail": "D1 is older than REPLAY_CHAIN_WINDOW_MS (72hr)",
    "notes": [
      "The provisional-block window is 72 hours.",
      "A denial receipt D1 created more than 72hr ago cannot anchor an E1.",
      "The gate computes now - D1.created_at_ms > 72hr and rejects with provisional_window_expired.",
      "This mirrors the revocation.ts PROVISIONAL_BLOCK_WINDOW_MS constant."
    ],
    "d1_age_ms_over_window": 1000,
    "window_ms": 259200000
  },
  {
    "name": "replay-chain: REJECT replay without HITL signal (empty signal OID)",
    "kind": "replay_chain_gate",
    "expect": "invalid",
    "expected_error_kind": "hitl_signal_missing",
    "expected_error_detail": "hitl_approval_signal_oid must be a non-empty string",
    "notes": [
      "The gate requires hitl_approval_signal_oid to be present and non-empty.",
      "An empty string or absent field is rejected as hitl_signal_missing.",
      "This enforces that callers authenticate the HITL signal before attempting replay."
    ]
  },
  {
    "name": "replay-chain: chain length=1 (E1 without replayed_after) is a standalone receipt, not a chain",
    "kind": "replay_chain_pair",
    "expect": "invalid",
    "expected_error_kind": "missing_replayed_after",
    "expected_error_detail": "E1.body.replayed_after must be present for a replay chain receipt",
    "notes": [
      "C9 gap / S2.9.",
      "A receipt with prev set but no replayed_after in its body is NOT a replay chain.",
      "The prev field alone (Merkle parent) does not satisfy the replay-chain contract.",
      "The body MUST carry replayed_after pointing at the denial receipt OID.",
      "Falsifiability: accept any receipt with prev as a valid chain. The gate would",
      "  emit a false 'valid chain' result and this vector fails.",
      "Spec reference: replay-chain contract; E1 body invariant."
    ],
