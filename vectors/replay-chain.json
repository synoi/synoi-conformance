[
  {
    "name": "replay-chain: valid D1 -> E1 chain (denial-then-execution)",
    "kind": "replay_chain_pair",
    "expect": "valid",
    "notes": [
      "S2.3 - 2-receipt downgrade per re-panel verdict.",
      "D1 is a denial receipt (status=denied, no replayed_after).",
      "E1 is an execution receipt (status=ok) carrying:",
      "  replayed_after = D1.oid  (body field, signed into canonical projection)",
      "  prev           = D1.oid  (envelope Merkle parent edge)",
      "  authority.subject_oid = D1.oid  (verifier walk target)",
      "Non-claim discipline: this chain is NOT labelled 'Replay Approval'.",
      "External label: 'denied at T0, HITL approved, executed at T1'.",
      "Merkle edge: E1.prev === D1.oid  (same edge pattern as supersedeReceipt).",
      "Hash values below are representative sha256: placeholder OIDs;",
      "a conformance harness must compute real OIDs before verifying signatures."
    ],
