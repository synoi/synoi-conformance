  {
    "name": "replay-chain: REJECT E1 with replayed_after != prev (broken Merkle edge)",
    "kind": "replay_chain_pair",
    "expect": "invalid",
    "expected_error_kind": "merkle_edge_mismatch",
    "expected_error_detail": "E1.prev must equal E1.body.replayed_after",
    "notes": [
      "A well-formed chain requires E1.prev === E1.body.replayed_after.",
      "If they diverge, the Merkle parent edge and the body reference disagree.",
      "A conformance harness must detect and reject this as merkle_edge_mismatch."
    ],
