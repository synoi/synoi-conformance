{
  "vector": "witness-stub-rejection",
  "spec_version": "synoi.witness.p6c.1",
  "description": "P6c/P6a: a stub witness proof is REJECTED offline by the real Rekor inclusion verifier, and a genuine Rekor entry is NOT. The rejection predicate is: a proof is rejected before any network fetch when witness_kind !== \"rekor\" OR uuid starts with \"stub:\" OR server starts with \"stub://\". These sentinels are values a real Rekor server can never emit (real uuids are hex, real servers are https). A genuine entry additionally reproduces its checkpoint rootHash via RFC 6962 inclusion (leaf = SHA256(0x00||body), node = SHA256(0x01||left||right)), which a stub cannot: it carries no inclusion proof. Language-neutral: a reimplementation applies the predicate and the inclusion fold from the fields below alone.",
  "rejection_predicate": {
    "reject_if_any": [
      "witness_kind != \"rekor\"",
      "uuid startsWith \"stub:\"",
      "server startsWith \"stub://\""
    ],
    "rejected_status": "proof-invalid",
    "rejected_verified": false,
    "note": "proof-invalid (not unverified): a stub proof reaching the real verifier is an injection/integrity event and must read loud."
  },
